# Backend-local environment overrides. Copy to `backend/.env`.
# See the project-root `.env.example` for the full, documented list of options.

ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/analyzer.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
