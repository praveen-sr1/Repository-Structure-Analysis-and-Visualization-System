# ============================================================================
# Repository Analyzer — example environment configuration
# Copy this file to `.env` (project root) or `backend/.env` and adjust values.
# ============================================================================

# ---- Application ----
APP_NAME="Repository Analyzer"
ENVIRONMENT=development           # development | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Database ----
# SQLite file path (relative paths are resolved against the backend working dir)
DATABASE_URL=sqlite:///./data/analyzer.db

# ---- CORS ----
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Scanning ----
# Comma-separated directory names to ignore while scanning.
IGNORED_DIRS=.git,node_modules,venv,.venv,dist,build,__pycache__,.pytest_cache,.mypy_cache,.ruff_cache,.idea,.vscode
# Maximum file size (bytes) to read for parsing. Larger files are skipped.
MAX_FILE_SIZE=1048576

# ---- AI provider ----
# Provider selection: openai | gemini | none
AI_PROVIDER=none
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Shared generation settings
AI_MAX_TOKENS=600
AI_TEMPERATURE=0.2

# ---- Frontend (Vite) ----
# Base URL the frontend uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:8000/api
